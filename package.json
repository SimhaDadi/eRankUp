{
    "name": "erankup-monorepo",
    "version": "0.0.1",
    "private": true,
    "workspaces": [
        "backend",
        "frontend",
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build --workspaces",
        "test": "npm run test --workspaces",
        "deploy:prod": "docker-compose -f docker-compose.prod.yml up -d --build",
        "logs:prod": "docker-compose -f docker-compose.prod.yml logs -f"
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1"
    }
}