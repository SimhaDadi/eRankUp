# --- eRankUp Production Environment Variables ---
# Copy this file to .env and fill in your values

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=your_secure_password_here
DB_NAME=erankup_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=kafka:9092

# Security (JWT) - Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# AI Provider (gemini | groq)
AI_PROVIDER=groq

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_REASONING=llama-3.3-70b-versatile

# Gemini (Fallback for embeddings)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
MOCK_AI=false
SKIP_SEEDING=true

# Google OAuth (Sign-in)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://erankup.in/api/auth/google/callback

# App Settings
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://erankup.in

# Admin Seeding (REQUIRED for admin user management)
# Set SEED_ADMIN=true to create/update admin user on startup
SEED_ADMIN=false
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_strong_admin_password_here

# Optional: Student user for testing (only created if SEED_ADMIN=true)
# STUDENT_EMAIL=student@test.com
# STUDENT_PASSWORD=student_password_here
