{
    "name": "erankup-backend",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start --entryFile src/main",
        "start:dev": "nest start --watch --entryFile src/main",
        "start:debug": "nest start --debug --watch --entryFile src/main",
        "start:prod": "node dist/backend/src/main",
        "start:win": "node dist/backend/src/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "seed": "ts-node src/seed.ts",
        "audit:bulk": "node src/scripts/bulk_audit_raw.js",
        "typeorm": "typeorm-ts-node-commonjs",
        "migration:generate": "npm run typeorm migration:generate src/migrations/InitialMigration -- -d src/data-source.ts",
        "migration:run": "npm run typeorm migration:run -- -d src/data-source.ts",
        "migration:run:prod": "typeorm migration:run -d dist/backend/src/data-source.js",
        "migration:revert": "npm run typeorm migration:revert -- -d src/data-source.ts",
        "stress-test": "ts-node scripts/stress-test.ts",
        "sync-vectors": "ts-node src/scripts/vector-sync.ts"
    },
    "dependencies": {
        "@erankup/shared": "*",
        "@google/generative-ai": "^0.24.1",
        "@nestjs/common": "10.4.15",
        "@nestjs/config": "3.2.2",
        "@nestjs/core": "10.4.15",
        "@nestjs/jwt": "10.2.0",
        "@nestjs/mapped-types": "2.0.6",
        "@nestjs/microservices": "10.4.15",
        "@nestjs/mongoose": "10.1.0",
        "@nestjs/passport": "10.0.3",
        "@nestjs/platform-express": "10.4.15",
        "@nestjs/platform-socket.io": "10.4.15",
        "@nestjs/schedule": "4.1.2",
        "@nestjs/serve-static": "4.0.2",
        "@nestjs/throttler": "6.3.0",
        "@nestjs/typeorm": "10.0.2",
        "@nestjs/websockets": "10.4.15",
        "@types/bcrypt": "^6.0.0",
        "@types/multer": "^2.0.0",
        "@types/nodemailer": "^7.0.5",
        "@types/passport-google-oauth20": "^2.0.17",
        "@types/passport-jwt": "^4.0.1",
        "axios": "^1.13.2",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "csv-parser": "^3.2.0",
        "express": "^4.22.1",
        "file-type": "^16.5.4",
        "firebase-admin": "^13.7.0",
        "google-auth-library": "^10.5.0",
        "groq-sdk": "^0.37.0",
        "helmet": "^8.1.0",
        "ioredis": "^5.9.2",
        "kafkajs": "^2.2.4",
        "lru-cache": "^7.18.3",
        "mongoose": "^8.0.3",
        "nodemailer": "^7.0.12",
        "openai": "^4.28.0",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.18.0",
        "razorpay": "^2.9.6",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.8.1",
        "serve-static": "^1.16.3",
        "sharp": "^0.34.5",
        "socket.io": "^4.7.2",
        "typeorm": "0.3.17"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.0.0",
        "@nestjs/schematics": "^10.0.0",
        "@nestjs/testing": "^10.0.0",
        "@types/express": "^4.17.17",
        "@types/jest": "^29.5.2",
        "@types/node": "^20.3.1",
        "@types/sharp": "^0.31.1",
        "@types/supertest": "^2.0.12",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "autocannon": "^8.0.0",
        "eslint": "^8.42.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "jest": "^29.5.0",
        "prettier": "^3.0.0",
        "source-map-support": "^0.5.21",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.0",
        "ts-loader": "^9.4.3",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.1.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
